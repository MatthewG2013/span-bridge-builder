{
  "name": "bridge-builder",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Span — a physics bridge builder game with a zero-dependency Node backend.",
  "scripts": {
    "build": "tsc -p tsconfig.client.json && tsc -p tsconfig.server.json",
    "start": "node dist/server/server.js",
    "launch": "node scripts/launch.mjs",
    "package": "node scripts/package-portable.mjs",
    "package:full": "node scripts/package-portable.mjs --only=full",
    "package:lite": "node scripts/package-portable.mjs --only=lite",
    "test": "node --test --experimental-test-isolation=none tests/physics.test.mjs tests/server.test.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
